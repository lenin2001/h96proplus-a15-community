 	else
--- a/drivers/staging/media/meson/vdec/vdec.c
+++ b/drivers/staging/media/meson/vdec/vdec.c
@@ -419,8 +419,16 @@
 	    codec_ops->program_capture_buf)
 		codec_ops->program_capture_buf(sess, vb);
 
+	/*
+	 * h96 06.09: recycl'im CAPTURE-bufer TOL'KO posle togo, kak fw ego hotya
+	 * by raz vydal (buf_output). Inache pervichnye CCodec-QBUF (surface-rejim,
+	 * prihodyat POSLE streamon_cap) recycl'ili by aktivnye reference-bufery fw
+	 * -> DPB fw rushilsya -> hang. V MMAP pervichnye QBUF idut do streamon_cap
