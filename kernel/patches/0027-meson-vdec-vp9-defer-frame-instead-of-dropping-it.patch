+/*
+ * h96 0027 (12.09.2026): perezapis' TOL'KO tablicy referensov ANC2AXI, BEZ
+ * kakih-libo allokacij.
+ *
+ * ZACHEM. Tablica pishetsya avtoinkrementom celikom, po odnomu slotu na indeks
+ * DPB. Slot dlya indeksa, kotoryj na moment proshloj zapisi eshche ne byl
+ * zamaplen (vb2_plane_cookie() == NULL), poluchil carry-forward - adres CHUZHOGO
+ * bufera (vetka last_y/last_uv v codec_hevc_setup_buffers_gxl, kommentarij
+ * "Variant B" ot 05.09.2026). Kadr v takoj bufer zapishetsya verno
+ * (codec_vp9_set_sao daet nastoyashchij adres zapisi), a vot posleduyushchie
+ * kadry prochtut ego kak REFERENS po chuzhomu adresu - eto i est' kvadraty /
+ * vertikal'nye polosy musora. U H264 dyru zakryvaet .program_capture_buf
+ * (amvdec_reprogram_canvas_slot), u VP9 takogo puti do sih por ne bylo.
+ *
+ * POCHEMU NEL'ZYA prosto pozvat' codec_hevc_setup_buffers(): na 10-bit ona
+ * uhodit v codec_hevc_alloc_fbc_buffers(), a ta perezapisyvaet
+ * comm->fbc_buffer_vaddr[] ne osvobozhdaya staroe - tech' po celomu FBC-naboru
+ * na kazhdyj vyzov iz goryachego puti QBUF.
+ *
+ * OGRANICHENIE (soznatel'noe). Vyhodim srazu, esli ispol'zuyutsya MMU/FBC/
+ * downsample, t.e. na 10-bit. Tam adres beretsya iz comm->fbc_buffer_paddr[idx]
+ * / mmu_header_paddr[idx] PO INDEKSU i carry-forward nevozmozhen v printsipe,
+ * tak chto chinit' nechego; zato my garantirovanno ne chitaem hranilishche,
+ * kotoroe moglo byt' ne vydeleno. Na GXM (revision < G12A) use_mmu vsegda 0,
+ * a use_fbc/use_downsample == is_10bit, poetomu dlya 8-bit NV12M eto chistyj
+ * MMIO iz adresov vb2 - bez allokacij, bez chteniya comm->*.
+ *
+ * BEZOPASNOST' POVTORA: maping bufera v vb2 v predelah sessii monotonen, tak
+ * chto povtornyj prohod mozhet tol'ko zamenit' carry-forward na nastoyashchij
+ * adres, no nikogda naoborot.
+ *
+ * KOGDA ZVAT': tol'ko kogda proshivka NE dekodiruet. Posledovatel'nost' zdes'
+ * zavershaetsya obnuleniem 32 slotov ANC_CANVAS_DATA, poetomu posle nee
+ * obyazatelen povtornyj codec_vp9_set_refs()/set_mc(). Edinstvennaya tochka
+ * vyzova - nachalo codec_vp9_process_frame(), gde proshivka stoit na
+ * VP9_HEAD_PARSER_DONE i zhdet nashego otveta.
+ */
+void codec_hevc_refresh_buffers(struct amvdec_session *sess,
+				struct codec_hevc_common *comm,
+				int is_10bit)
+{
+	struct amvdec_core *core = sess->core;
+
+	if (codec_hevc_use_mmu(core->platform->revision, sess->pixfmt_cap,
+			       is_10bit) ||
+	    codec_hevc_use_downsample(sess->pixfmt_cap, is_10bit) ||
+	    codec_hevc_use_fbc(sess->pixfmt_cap, is_10bit))
+		return;
+
+	if (core->platform->revision == VDEC_REVISION_GXBB)
+		codec_hevc_setup_buffers_gxbb(sess, comm, is_10bit);
+	else
+		codec_hevc_setup_buffers_gxl(sess, comm, is_10bit);
+}
+EXPORT_SYMBOL_GPL(codec_hevc_refresh_buffers);
