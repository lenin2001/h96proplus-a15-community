 #include "vdec.h"
 
+#include <media/videobuf2-dma-contig.h>
+
+/* h96 (01.09.2026): Android gralloc отдаёт NV12 одним dmabuf, а
+ * vb2-dma-contig игнорирует смещение плоскости при импорте — адрес
+ * плоскости 1 совпадает с плоскостью 0. Без поправки цветность пишется
+ * поверх люмы с нулевого смещения, а потребитель ищет её по
+ * stride*ALIGN(h,32) и находит нули (зелёный кадр). Та же поправка, что
+ * в set_canvas_nv12m (vdec_helpers.c) от 26.08. Раскладка minigbm:
+ * stride = ALIGN(width, 64), цветность после ALIGN(height, 32) строк
+ * люмы. Для ширин, не кратных 64, внутренний страйд HEVC-ядра может
+ * разойтись с gralloc — на типовых 1280/1920/3840 совпадает. */
+static inline dma_addr_t
+codec_hevc_chroma_paddr(struct amvdec_session *sess, struct vb2_buffer *vb)
+{
+	dma_addr_t buf_y = vb2_dma_contig_plane_dma_addr(vb, 0);
+	dma_addr_t buf_uv = vb2_dma_contig_plane_dma_addr(vb, 1);
+
+	if (buf_uv == buf_y)
+		buf_uv = buf_y +
+			 (dma_addr_t)ALIGN(sess->width, 64) *
+			 ALIGN(sess->height, 32);
+
+	return buf_uv;
+}
