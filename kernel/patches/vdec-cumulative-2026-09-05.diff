 	h264->max_refs = ((parsed_info >> MAX_REF_BIT) & MAX_REF_MASK) + 1;
 
+	/* The GXM H.264 microcode exposes only 24 canvas slots (ANC0..23).
+	 * Streams without an explicit max_dec_frame_buffering make the
+	 * firmware report max_refs = 24, so the requested DPB (max_refs + 5)
+	 * exceeds the canvas pool and decode stalls forever waiting for
+	 * free frames. Clamp so DPB + userspace extras still fit in 24.
