+			   __GFP_HIGHMEM /* h96 0026: not __GFP_MOVABLE - keep zspages out of CMA, avoid zs_page_migrate race */, page_to_nid(page));
 	if (IS_ERR_VALUE(handle)) {
 		zcomp_stream_put(zstrm);
 		return PTR_ERR((void *)handle);
