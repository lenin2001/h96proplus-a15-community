 		return 0;
 	}
 
@@ -736,14 +787,20 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 
 	v4l2_m2m_mark_stopped(sess->m2m_ctx);
 
