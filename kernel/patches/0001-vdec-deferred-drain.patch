@@ -112,8 +112,54 @@ static void vdec_wait_inactive(struct amvdec_session *sess)
 		msleep(25);
 }
 
+/*
+ * Otlozhennyj drain po V4L2_DEC_CMD_STOP.
+ *
+ * Nemedlennyj drain lomal khvost potoka: flush vychishchal DPB, poka
+ * esparser eshche derzhal ne dekodirovannye AU, i poslednie kadry
+ * dekodirovalis bez opornykh ("Couldn t find ref. frame").
+ * vdec_wait_inactive zdes ne spasaet: 50 ms tishiny IRQ neotlichimy
+ * ot golodaniya po CAPTURE-buferam u medlennogo klienta.
+ *
+ * Zhdem, poka konvejer dojedet: chislo buferov v esparser perestalo
+ * ubyvat ~1 s podryad. Potolok 10 s, dalshe dreniruem kak est.
+ */
+static void vdec_drain_work(struct work_struct *work)
+{
+	struct amvdec_session *sess =
+		container_of(to_delayed_work(work), struct amvdec_session,
+			     drain_work);
+	struct amvdec_codec_ops *codec_ops = sess->fmt_out->codec_ops;
+	int queued = atomic_read(&sess->esparser_queued_bufs);
+
+	if (!sess->should_stop)
+		return;
+
+	if (queued == sess->drain_prev_queued)
+		sess->drain_stable_ticks++;
+	else
+		sess->drain_stable_ticks = 0;
+	sess->drain_prev_queued = queued;
+	sess->drain_total_ticks++;
+
+	if (queued == 0 || sess->drain_stable_ticks >= 10 ||
+	    sess->drain_total_ticks >= 100) {
+		dev_dbg(sess->core->dev,
+			"deferred drain: queued %d, stable %u, total %u\n",
+			queued, sess->drain_stable_ticks,
+			sess->drain_total_ticks);
+		vdec_wait_inactive(sess);
+		if (codec_ops->drain)
+			codec_ops->drain(sess);
+		return;
+	}
+
+	schedule_delayed_work(&sess->drain_work, msecs_to_jiffies(100));
+}
+
 static void vdec_poweroff(struct amvdec_session *sess)
 {
+	cancel_delayed_work_sync(&sess->drain_work);
 	struct amvdec_ops *vdec_ops = sess->fmt_out->vdec_ops;
 	struct amvdec_codec_ops *codec_ops = sess->fmt_out->codec_ops;
 
@@ -323,6 +369,7 @@ static int vdec_start_streaming(struct vb2_queue *q, unsigned int count)
