From: Claude <noreply@anthropic.com>
Subject: [PATCH 0040] EXPERIMENT meson-vdec: es_split_ms / vld_fill_gate

Not part of the installed kernel. es_split_ms=N writes each H.264 packet >= 16K as
two parser operations N ms apart, so the VLD waits at the write pointer in the
middle of a picture; vld_fill_gate stops VLD fetch while the parser writes.
es_split_ms=20 left the AVC corruption rate at background (1/10), which rejected
the 'VLD overtakes the parser' hypothesis; vld_fill_gate was therefore not needed.

---
diff -ruN s39/drivers/staging/media/meson/vdec/esparser.c s40/drivers/staging/media/meson/vdec/esparser.c
--- a/drivers/staging/media/meson/vdec/esparser.c
+++ b/drivers/staging/media/meson/vdec/esparser.c
@@ -7,6 +7,7 @@
  * It reads bitstream buffers and feeds them to the VIFIFO
  */
 
+#include <linux/delay.h>
 #include <linux/init.h>
 #include <linux/ioctl.h>
 #include <linux/list.h>
@@ -54,6 +55,14 @@
 #define VP9_HEADER_SIZE		16
 
 static DECLARE_WAIT_QUEUE_HEAD(wq);
+
+/* h96 0040: experiment knobs for the H.264 VIFIFO read-ahead race (default off) */
+static unsigned int es_split_ms;
+module_param(es_split_ms, uint, 0644);
+MODULE_PARM_DESC(es_split_ms, "write H.264 packets >= 16K in two halves this many ms apart");
+static bool vld_fill_gate;
+module_param(vld_fill_gate, bool, 0644);
+MODULE_PARM_DESC(vld_fill_gate, "stop VLD fetch from VIFIFO while the parser writes a packet");
 static int search_done;
 
 static irqreturn_t esparser_isr(int irq, void *dev)
@@ -232,6 +241,35 @@
 	return wait_event_interruptible_timeout(wq, search_done, (HZ / 5));
 }
 
+static int esparser_write_split(struct amvdec_core *core,
+				struct vb2_buffer *vb, u32 size, u32 ms)
+{
+	u8 *src = vb2_plane_vaddr(vb, 0);
+	u32 h1 = ALIGN_DOWN(size / 2, 64), part[2] = { h1, size - h1 };
+	dma_addr_t paddr;
+	u8 *vaddr;
+	int i, ret = 0;
+
+	vaddr = dma_alloc_coherent(core->dev, h1 + part[1] + SEARCH_PATTERN_LEN,
+				   &paddr, GFP_KERNEL);
+	if (!vaddr || !src)
+		return -ENOMEM;
+	for (i = 0; i < 2; i++) {
+		memcpy(vaddr, src + (i ? h1 : 0), part[i]);
+		memset(vaddr + part[i], 0, SEARCH_PATTERN_LEN);
+		vaddr[part[i] + 2] = 0x01;
+		vaddr[part[i] + 3] = 0xff;
+		ret = esparser_write_data(core, paddr, part[i]);
+		if (ret <= 0)
+			break;
+		if (!i)
+			msleep(ms);
+	}
+	dma_free_coherent(core->dev, h1 + part[1] + SEARCH_PATTERN_LEN,
+			  vaddr, paddr);
+	return ret;
+}
+
 static u32 esparser_vififo_get_free_space(struct amvdec_session *sess)
 {
 	u32 vififo_usage;
@@ -355,7 +393,28 @@
 	}
 
 	pad_size = esparser_pad_start_code(core, vb, payload_size);
-	ret = esparser_write_data(core, phy, payload_size + pad_size);
+	{
+		bool h264 = sess->fmt_out->pixfmt == V4L2_PIX_FMT_H264;
+		bool gate = h264 && READ_ONCE(vld_fill_gate);
+		u32 split = h264 ? READ_ONCE(es_split_ms) : 0;
+
+		if (gate)
+			amvdec_clear_dos_bits(core, VLD_MEM_VIFIFO_CONTROL,
+					      MEM_CTRL_FILL_EN);
+		if (split && payload_size + pad_size >= SZ_16K)
+			ret = esparser_write_split(core, vb,
+						   payload_size + pad_size, split);
+		else
+			ret = esparser_write_data(core, phy,
+						  payload_size + pad_size);
+		if (gate) {
+			/* let the parser's last writes land before the VLD fetches */
+			amvdec_read_parser(core, PARSER_VIDEO_WP);
+			udelay(20);
+			amvdec_write_dos_bits(core, VLD_MEM_VIFIFO_CONTROL,
+					      MEM_CTRL_FILL_EN);
+		}
+	}
 
 	if (ret <= 0) {
 		dev_warn(core->dev, "esparser: input parsing error\n");
