-	 * eto drain_issued iz vdec_drain_work, kotoryj zhdet uspokoeniya
-	 * esparser do 10 s; dlya eos_sequence (h264) - eos_queued, t.e.
-	 * fiktivnaya kartinka uzhe ushla v firmware. Absolyutnyj predel 15 s
-	 * ot CMD_STOP vse ravno ostaetsya: obrezannyj hvost luchshe vechnogo
-	 * zavisaniya, radi kotorogo etot patch i sdelan.
-	 */
-	if (time_before(jiffies, sess->stop_jiffies + msecs_to_jiffies(15000))) {
-		if (codec_ops->drain && !sess->drain_issued)
-			goto again;
-		if (!codec_ops->drain && codec_ops->eos_sequence &&
-		    !sess->eos_queued)
-			goto again;
-
-		/* zhelezo eshche otdaet kadry - pust LAST povesit obychnyj put */
-		if (time_before(jiffies,
-				sess->last_dst_jiffies + msecs_to_jiffies(200))) {
-			sess->eos_ticks = 0;
-			goto again;
+	if (codec_ops->drain) {
+		if (!sess->drain_done)
+			goto not_done;
+	} else {
+		quiet_from = sess->last_dst_jiffies;
+		if (codec_ops->eos_sequence) {
+			if (!sess->eos_queued)
+				goto not_done;
+			if (time_after(sess->eos_queued_jiffies, quiet_from))
+				quiet_from = sess->eos_queued_jiffies;
 		}
+		if (time_before(now, quiet_from + msecs_to_jiffies(200)))
+			goto not_done;
 	}
+	goto terminate;
+
+not_done:
+	if (time_before(now, sess->stop_jiffies + msecs_to_jiffies(15000)) ||
+	    time_before(now, sess->last_dst_jiffies + msecs_to_jiffies(1000)))
+		goto again;
+	forced = true;
 
+terminate:
 	vbuf = v4l2_m2m_dst_buf_remove(sess->m2m_ctx);
 	if (!vbuf) {
-		/* klient poka ne vernul ni odnogo svobodnogo CAPTURE-bufera */
-		if (++sess->eos_ticks > 60) {
-			dev_warn(sess->core->dev,
-				 "vdec: drain ne zavershen, net CAPTURE-bufera\n");
-			return;
-		}
-		goto again;
+		/* terminator dolzhen, no bufera net - ego vernet QBUF */
+		sess->eos_pending = 1;
+		goto out;
 	}
+	sess->eos_pending = 0;
 
 	for (i = 0; i < vbuf->vb2_buf.num_planes; i++)
 		vb2_set_plane_payload(&vbuf->vb2_buf, i, 0);
 
+	idx = vbuf->vb2_buf.index;
+	if (idx < 32)
+		sess->buf_output[idx] = false;
+	vbuf->flags = forced ? V4L2_BUF_FLAG_ERROR : 0;
 	vbuf->sequence = sess->sequence_cap++;
 	vbuf->field = V4L2_FIELD_NONE;
 	sess->last_sent = 1;
-	dev_dbg(sess->core->dev, "vdec: drain zavershen pustym LAST\n");
+	stop_ms = jiffies_to_msecs(now - sess->stop_jiffies);
 	v4l2_event_queue_fh(&sess->fh, &ev);
 	v4l2_m2m_last_buffer_done(sess->m2m_ctx, vbuf);
+	spin_unlock_irqrestore(&sess->eos_lock, flags);
+
+	if (forced)
+		dev_err(sess->core->dev,
+			"vdec: drain NE zavershen za %u ms (drain_done=%u eos_queued=%u) - LAST s ERROR\n",
+			stop_ms, sess->drain_done, sess->eos_queued);
+	else
+		dev_dbg(sess->core->dev,
+			"vdec: drain zavershen pustym LAST cherez %u ms (buf %u)\n",
+			stop_ms, idx);
 	return;
 
 again:
+	spin_unlock_irqrestore(&sess->eos_lock, flags);
 	schedule_delayed_work(&sess->eos_work, msecs_to_jiffies(50));
+	return;
+out:
+	spin_unlock_irqrestore(&sess->eos_lock, flags);
+}
+
+/*
+ * h96 0031: vse sostoyanie konca potoka - v nol, i vse ranee vzvedennye
+ * STOP stanovyatsya nedejstvitelnymi. Vyzyvaetsya POSLE otmeny drain_work
+ * i eos_work.
+ */
+static void vdec_eos_reset(struct amvdec_session *sess)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sess->eos_lock, flags);
+	sess->should_stop = 0;
+	sess->eos_queued = 0;
+	sess->last_sent = 0;
+	sess->drain_done = 0;
+	sess->eos_pending = 0;
+	sess->frames_after_last = 0;
+	sess->eos_gen++;
+	spin_unlock_irqrestore(&sess->eos_lock, flags);
 }
 
 static void vdec_poweroff(struct amvdec_session *sess)
