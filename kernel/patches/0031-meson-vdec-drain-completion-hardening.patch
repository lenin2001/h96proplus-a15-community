+			/*
+			 * h96 0031: drain() SINHRONNO otdaet ves hvost DPB (vp9/
+			 * hevc flush_output pod svoim codec-lock) - tolko ego
+			 * VOZVRAT i est nastoyashchee zavershenie. Flag stavim
+			 * posle vyzova, a ne do nego, inache eos_work mog
+			 * otdat LAST parallelno s vydachej hvosta.
+			 */
 			codec_ops->drain(sess);
+			spin_lock_irqsave(&sess->eos_lock, flags);
+			sess->drain_done = 1;
+			spin_unlock_irqrestore(&sess->eos_lock, flags);
+			mod_delayed_work(system_wq, &sess->eos_work, 0);
 		}
 		return;
 	}
@@ -290,13 +302,41 @@
  * ~100 raz v sekundu: video-render nikogda ne konchaetsya, plejer ne
  * zakryvaetsya i ne perehodit k sleduyushchemu roliku.
  *
- * Posle CMD_STOP zhdem 200 ms tishiny na CAPTURE i, esli LAST tak i ne
- * ushel, otdaem pustoj bufer s LAST i sobytiem EOS. Potolok ozhidaniya
- * klientskogo bufera - 3 s.
+ * Posle CMD_STOP otdaem pustoj bufer s LAST i sobytiem EOS, kogda drain
+ * DEJSTVITELNO zavershen (sm. nizhe), esli LAST tak i ne ushel s realnym
+ * kadrom.
+ *
+ * h96 0031 (23.09), razbor Codex ot 22.09 - chto zdes teper garantiruetsya:
+ *
+ * 1. Kriterij zaversheniya - nastoyashchij, gde on est. U kodekov s
+ *    codec_ops->drain (vp9, hevc) drain() sinhronno otdaet ves hvost DPB;
+ *    vdec_drain_work stavit drain_done POSLE ego vozvrata i srazu budit
+ *    nas - nikakogo tajmera tishiny. Tajmer (eos_queued + 200 ms bez
+ *    kadrov POSLE podachi EOS-kartinki) ostaetsya TOLKO dlya kodekov bez
+ *    .drain (h264, mpeg12): u ih proshivki signala "DPB pust" net.
+ * 2. 15 s ot STOP - eto ne uspeh, a avariya: srabatyvaet tolko esli za
+ *    1 s ne bylo ni odnogo kadra, i terminator uhodit s
+ *    V4L2_BUF_FLAG_ERROR i dev_err, a ne kak chistyj konec potoka.
+ * 3. Net CAPTURE-bufera - ne sdaemsya: eos_pending, i pervyj zhe QBUF
+ *    CAPTURE (vdec_vb2_buf_queue) budit vorker snova.
+ * 4. Reshenie "LAST uzhe ushel?" + sequence_cap + publikaciya - odna
+ *    tranzakciya pod eos_lock, i v dst_buf_done tozhe; poetomu LAST rovno
+ *    odin, a realnyj kadr ne mozhet ujti POSLE nego nezamechennym
+ *    (schetchik frames_after_last + dev_warn).
+ * 5. Pokolenie: kazhdyj STOP/START/streamon/streamoff menyaet eos_gen;
+ *    vorker, vzvedennyj starym STOP, nichego ne delaet.
  *
- * Lok zdes ne berem (kak i vdec_drain_work): vdec_stop_streaming()
- * vyzyvaet cancel_delayed_work_sync() pod tem zhe sess->lock, i vzyatie
- * loka vnutri vorkera dalo by AB-BA dedlok.
+ * Bufer-terminator beretsya iz ready-spiska m2m. Dlya vp9/hevc tam tolko
+ * bufery, kotoryh net v spiskah kadrov kodeka (posle drain() spiski
+ * pusty), t.e. proshivka v nih ne pishet. Dlya h264 bufer v ready-spiske
+ * uzhe otdan proshivke cherez recycle kak svobodnyj; posle LAST klient
+ * vozvrashchaet pustyshku QBUF-om ranshe, chem DEC_CMD_START, a
+ * buf_output[idx] snimaem, chtoby etot QBUF ne otdal proshivke tot zhe
+ * indeks VTOROJ raz.
+ *
+ * Lok sess->lock zdes ne berem (kak i vdec_drain_work): vdec_stop_streaming()
+ * vyzyvaet cancel_delayed_work_sync() pod nim, i vzyatie loka vnutri
+ * vorkera dalo by AB-BA dedlok.
  */
 static void vdec_eos_work(struct work_struct *work)
 {
@@ -304,63 +344,99 @@
 		container_of(to_delayed_work(work), struct amvdec_session,
