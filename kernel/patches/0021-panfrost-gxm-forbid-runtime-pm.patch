+++ b/drivers/gpu/drm/panfrost/panfrost_device.h
@@ -43,11 +43,15 @@ enum panfrost_drv_comp_bits {
  * @GPU_PM_VREG_OFF: Allow turning off regulators during system suspend
  * @GPU_PM_RT: Allow disabling clocks and asserting the reset control during
  *  system runtime suspend
+ * @GPU_PM_RT_FORBID: Never runtime-suspend the device (pm_runtime_forbid)
  */
 enum panfrost_gpu_pm {
 	GPU_PM_CLK_DIS,
 	GPU_PM_VREG_OFF,
-	GPU_PM_RT
+	GPU_PM_RT,
+	/* h96 0021: keep the device runtime-active (core power-off never
+	 * completes on Amlogic GXM Mali-T820; runtime suspend saves nothing there) */
+	GPU_PM_RT_FORBID
 };
 
