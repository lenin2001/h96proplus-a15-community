Subject: [PATCH] media: meson: vdec - referensy VP9, zelenyj kadr i seek

Sostoyanie dereva yadra na 01.09.2026 otnositel'no kommita 6c8eb7356.
Vse pravki PROVERENY NA ZHELEZE (H96 Pro Plus, S912): posle nih peremotka
v SmartTube rabotaet, dekoder ne obryvaet sessiyu, metki vremeni
sopostavlyayutsya (0 soobshchenij "can't match offset" za tri peremotki).

Chto lechit:

  * zelenyj ekran v VP9
      - codec_vp9_flush_output() ne sbrasyval ref_frame_map/frame_refs,
        posle seek karta ukazyvala na osvobozhdennye vb2-indeksy;
      - set_refs()/set_mc() na NULL delali continue, a porty ANC_CANVAS i
        REFINFO avtoinkrementnye - propusk SDVIGAL tablicu. Y=0,U=0,V=0
        po BT.709 limited = RGB(0,135,0), rovno zelen'.

  * "couldn't find VP9 ref N"
      - rm_noshow_frame() otdaval bufer po odnoj proverke show == 0,
        no show == 0 v VP9 eto zhivoj alt-ref.

  * zavisanie peremotki
      - vdec_wait_inactive() zhdal tishiny IRQ BEZ verhnej granicy, pod
        sess->lock i core->lock - umiral ves' /dev/video0.

  * zavisanie pri smene kodeka
      - potok vdec_recycle sirotel i chital MMIO pri pogashennom dos_clk;
      - amvdec_src_change() SINHRONNO zovet resume(), berushchij tot zhe
        vp9->lock, chto derzhit tred preryvaniya - samoblokirovka.

  * tihie povrezhdeniya
      - kadr s vb2-indeksom >= 24 zatiral RPM v workspace;
      - visyachij prev_frame posle flush uezzhal v HEVC_MPRED_MV_*;
      - vechnyj cikl v codec_vp9_get_new_frame() v trede preryvaniya.

CHEGO ZDES' SOZNATEL'NO NET (probovali 01.09, slomalo vosproizvedenie):

  * strogij gejt v esparser_queue() vmesto bezznakovogo perepolneniya
    "num_dst_bufs -= 3". Perepolnenie tam VYPOLNYAET RABOTU: ono
    otklyuchaet gejt, poka buferov eshche net. Bez nego - tupik: parser ne
    kormit, dekoder ne vydaet pervyj kadr, prilozhenie ne stavit bufery.

  * bezuslovnyj atomic_dec(esparser_queued_bufs). Snimaet zalipanie
    schetchika, no vmeste so strogim gejtom sdvigaet balans podachi, i
    dekoder upiraetsya v "No dst buffer available" -> Aborting.

  * vdec_reset_timestamps() i sbros last_offset/wrap_count v BEZUSLOVNOJ
    chasti vdec_stop_streaming(). Eta funkciya vyzyvaetsya dlya KAZHDOJ
    ocheredi otdel'no, i pri obychnoj peremotke plejer gasit tol'ko
    CAPTURE, a OUTPUT rabotaet. Stiranie metok tam delaet sopostavlenie
    nevozmozhnym: kazhdyj kadr uezzhaet bez metki, plejer schitaet ego
    ustarevshim i vybrasyvaet - ekran chernyj pri zhivom dekodere.

diff --git a/drivers/staging/media/meson/vdec/codec_h264.c b/drivers/staging/media/meson/vdec/codec_h264.c
index 77d75ed2c..64e67fb0d 100644
--- a/drivers/staging/media/meson/vdec/codec_h264.c
+++ b/drivers/staging/media/meson/vdec/codec_h264.c
@@ -342,6 +342,15 @@ static void codec_h264_src_change(struct amvdec_session *sess)
 
 	h264->max_refs = ((parsed_info >> MAX_REF_BIT) & MAX_REF_MASK) + 1;
 
+	/* The GXM H.264 microcode exposes only 24 canvas slots (ANC0..23).
+	 * Streams without an explicit max_dec_frame_buffering make the
+	 * firmware report max_refs = 24, so the requested DPB (max_refs + 5)
+	 * exceeds the canvas pool and decode stalls forever waiting for
+	 * free frames. Clamp so DPB + userspace extras still fit in 24.
+	 */
+	if (h264->max_refs > 15)
+		h264->max_refs = 15;
+
 	crop_infor = amvdec_read_dos(core, AV_SCRATCH_6);
 	crop_bottom = (crop_infor & 0xff);
 	crop_right = (crop_infor >> 16) & 0xff;
@@ -353,6 +362,8 @@ static void codec_h264_src_change(struct amvdec_session *sess)
 		frame_width, frame_height, crop_right, crop_bottom);
 
 	codec_h264_set_par(sess);
+	pr_info("h96 h264 src_change: %ux%u max_refs=%u dpb=%u\n",
+		frame_width, frame_height, h264->max_refs, h264->max_refs + 5);
 	amvdec_src_change(sess, frame_width, frame_height,
 			  h264->max_refs + 5, 8);
 }
diff --git a/drivers/staging/media/meson/vdec/codec_vp9.c b/drivers/staging/media/meson/vdec/codec_vp9.c
index 12c3bcd86..da9800bb9 100644
--- a/drivers/staging/media/meson/vdec/codec_vp9.c
+++ b/drivers/staging/media/meson/vdec/codec_vp9.c
@@ -689,6 +689,29 @@ static void codec_vp9_flush_output(struct amvdec_session *sess)
 		list_del(&tmp->list);
 		kfree(tmp);
 	}
+
+	/*
+	 * Karta referensov ZHIVET dol'she spiska kadrov. Do 01.09.2026 zdes'
+	 * chistilsya tol'ko ref_frames_list, a ref_frame_map[] ostavalsya so
+	 * starymi indeksami ot pozicii DO peremotki. Posle seek dekoder iskal
+	 * eti indeksy cherez codec_vp9_get_frame_by_idx(), ne nahodil ih i
+	 * pisal v zhurnal "couldn't find VP9 ref N" sotnyami strok.
+	 *
+	 * Dal'she huzhe: codec_vp9_set_refs() na NULL delaet continue i NE
+	 * pishet kanvas v HEVCD_MPP_ANC_CANVAS_DATA_ADDR. Zhelezo chitaet
+	 * nezapolnennyj bufer, a pustoj YUV (Y=0,U=0,V=0) - eto imenno
+	 * ZELENYJ kadr. Otsyuda zelen' posle peremotki.
+	 *
+	 * Sbrasyvaem kartu v -1, kak v codec_vp9_start(): sledujushchij kadr
+	 * posle seek vsegda klyuchevoj, ssylat'sya emu ne na chto.
+	 */
+	memset(&vp9->ref_frame_map, -1, sizeof(vp9->ref_frame_map));
+	memset(&vp9->next_ref_frame_map, -1, sizeof(vp9->next_ref_frame_map));
+	vp9->cur_frame = NULL;
+	vp9->prev_frame = NULL;
+	memset(vp9->frame_refs, 0, sizeof(vp9->frame_refs));
+	vp9->frames_num = 0;
+
 	mutex_unlock(&vp9->lock);
 }
 
@@ -982,24 +1005,119 @@ static void codec_vp9_set_sao(struct amvdec_session *sess,
 	amvdec_write_dos(core, HEVCD_IPP_AXIIF_CONFIG, val);
 }
 
+/*
+ * Ssylaetsya li na kadr hotya by odna karta referensov.
+ *
+ * 01.09.2026: dobavlena proverka next_ref_frame_map. Bez nee kadr, kotoryj
+ * tol'ko chto naznachen referensom dlya SLEDUYUSHCHEGO kadra, no eshche ne
+ * perenesen v ref_frame_map, schitalsya nenuzhnym i osvobozhdalsya.
+ */
+static bool codec_vp9_is_ref(struct codec_vp9 *vp9, struct vp9_frame *frame)
+{
+	int i;
+
+	for (i = 0; i < REF_FRAMES; ++i)
+		if (vp9->ref_frame_map[i] == frame->index ||
+		    vp9->next_ref_frame_map[i] == frame->index)
+			return true;
+
+	return false;
+}
+
+/*
+ * Prinadlezhit li ukazatel' spisku zhivyh kadrov.
+ *
+ * cur_frame i prev_frame - obychnye ukazateli, i posle flush pri peremotke
+ * oni ostayutsya visyachimi: kadr uzhe kfree(), a adres v pole lezhit. Chtenie
+ * po nemu v set_mpred_mv() davalo musornyj MV-adres pryamo v zhelezo.
+ */
+static bool codec_vp9_frame_is_live(struct codec_vp9 *vp9,
+				    struct vp9_frame *frame)
+{
+	struct vp9_frame *tmp;
+
+	if (!frame)
+		return false;
+
+	list_for_each_entry(tmp, &vp9->ref_frames_list, list)
+		if (tmp == frame)
+			return true;
+
+	return false;
+}
+
+/*
+ * Referens dlya slota i, s otkatom na lyuboj validnyj kadr.
+ *
+ * Porty HEVCD_MPP_ANC_CANVAS_DATA_ADDR i VP9D_MPP_REFINFO_DATA -
+ * avtoinkrementnye. Propusk odnogo slota ne "ostavlyaet pusto", a SDVIGAET
+ * vsyu ostal'nuyu tablicu, i ostavshiesya referensy nachinayut ukazyvat' na
+ * chuzhie kanvasy. Esli propushcheny vse tri - predskazanie idet iz nulevogo
+ * kanvasa, a Y=0,U=0,V=0 po BT.709 limited eto RGB(0,135,0), rovno tot samyj
+ * zelenyj ekran.
+ *
+ * Poetomu slot zapolnyaetsya vsegda. Kartinka do blizhajshego klyuchevogo kadra
+ * budet nevernoj (smazannoj ili dublirovannoj), no eto ne zelen' i tablica
+ * ostaetsya vyrovnennoj.
+ */
+static struct vp9_frame *codec_vp9_ref_or_fallback(struct codec_vp9 *vp9, int i)
+{
+	int j;
+
+	if (vp9->frame_refs[i])
+		return vp9->frame_refs[i];
+
+	for (j = 0; j < REFS_PER_FRAME; ++j)
+		if (vp9->frame_refs[j])
+			return vp9->frame_refs[j];
+
+	if (codec_vp9_frame_is_live(vp9, vp9->prev_frame))
+		return vp9->prev_frame;
+
+	return vp9->cur_frame;
+}
+
 static dma_addr_t codec_vp9_get_frame_mv_paddr(struct codec_vp9 *vp9,
 					       struct vp9_frame *frame)
 {
+	/*
+	 * V workspace rovno MAX_REF_PIC_NUM slotov MV, srazu za nimi lezhit
+	 * RPM. frame->index - eto vb2-indeks, on nichem ne ogranichen: kadr s
+	 * indeksom >= 24 zatiral RPM, i dekoder poluchal musornye
+	 * refresh_frame_flags i ref_info. Zavorachivaem indeks i shumim odin
+	 * raz, chtoby eto ne prohodilo tiho.
+	 */
+	WARN_ON_ONCE(frame->index >= MAX_REF_PIC_NUM);
+
 	return vp9->workspace_paddr + MPRED_MV_OFFSET +
-	       (frame->index * MPRED_MV_BUF_SIZE);
+	       ((frame->index % MAX_REF_PIC_NUM) * MPRED_MV_BUF_SIZE);
 }
 
 static void codec_vp9_set_mpred_mv(struct amvdec_core *core,
 				   struct codec_vp9 *vp9)
 {
 	int mpred_mv_rd_end_addr;
-	int use_prev_frame_mvs = vp9->prev_frame->width ==
-					vp9->cur_frame->width &&
-				 vp9->prev_frame->height ==
-					vp9->cur_frame->height &&
-				 !vp9->prev_frame->intra_only &&
-				 vp9->prev_frame->show &&
-				 vp9->prev_frame->type != KEY_FRAME;
+	struct vp9_frame *prev = vp9->prev_frame;
+	int use_prev_frame_mvs;
+
+	/*
+	 * 01.09.2026: posle flush pri peremotke prev_frame - visyachij
+	 * ukazatel' na uzhe osvobozhdennyj kadr. Ran'she ego polya chitalis'
+	 * pryamo zdes', i v HEVC_MPRED_MV_RD_START_ADDR uezzhal musornyj
+	 * adres.
+	 */
+	if (!codec_vp9_frame_is_live(vp9, prev))
+		prev = NULL;
+
+	use_prev_frame_mvs = prev &&
+			     prev->width == vp9->cur_frame->width &&
+			     prev->height == vp9->cur_frame->height &&
+			     !prev->intra_only &&
+			     prev->show &&
+			     prev->type != KEY_FRAME;
+
+	if (!prev)
+		prev = vp9->cur_frame;
 
 	amvdec_write_dos(core, HEVC_MPRED_CTRL3, 0x24122412);
 	amvdec_write_dos(core, HEVC_MPRED_ABV_START_ADDR,
@@ -1015,12 +1133,12 @@ static void codec_vp9_set_mpred_mv(struct amvdec_core *core,
 			 codec_vp9_get_frame_mv_paddr(vp9, vp9->cur_frame));
 
 	amvdec_write_dos(core, HEVC_MPRED_MV_RD_START_ADDR,
-			 codec_vp9_get_frame_mv_paddr(vp9, vp9->prev_frame));
+			 codec_vp9_get_frame_mv_paddr(vp9, prev));
 	amvdec_write_dos(core, HEVC_MPRED_MV_RPTR,
-			 codec_vp9_get_frame_mv_paddr(vp9, vp9->prev_frame));
+			 codec_vp9_get_frame_mv_paddr(vp9, prev));
 
 	mpred_mv_rd_end_addr =
-			codec_vp9_get_frame_mv_paddr(vp9, vp9->prev_frame) +
+			codec_vp9_get_frame_mv_paddr(vp9, prev) +
 			(vp9->lcu_total * MV_MEM_UNIT);
 	amvdec_write_dos(core, HEVC_MPRED_MV_RD_END_ADDR, mpred_mv_rd_end_addr);
 }
@@ -1121,7 +1239,7 @@ static void codec_vp9_sync_ref(struct codec_vp9 *vp9)
 
 		vp9->frame_refs[i] = codec_vp9_get_frame_by_idx(vp9, idx);
 		if (!vp9->frame_refs[i])
-			pr_warn("%s: couldn't find VP9 ref %d\n", __func__,
+			pr_warn_ratelimited("%s: couldn't find VP9 ref %d\n", __func__,
 				idx);
 	}
 }
@@ -1133,12 +1251,25 @@ static void codec_vp9_set_refs(struct amvdec_session *sess,
 	int i;
 
 	for (i = 0; i < REFS_PER_FRAME; ++i) {
-		struct vp9_frame *frame = vp9->frame_refs[i];
+		struct vp9_frame *frame = codec_vp9_ref_or_fallback(vp9, i);
 		int id_y;
 		int id_u_v;
 
+		/*
+		 * Zapis' idet v HEVCD_MPP_ANC_CANVAS_DATA_ADDR s
+		 * avtoinkrementom, poetomu "continue" na propavshem referense
+		 * ne prosto propuskal odin sloty - on SDVIGAL vsyu ostal'nuyu
+		 * tablicu, i ostavshiesya referensy nachinali ukazyvat' ne na
+		 * svoi kanvasy. Kartinka posle etogo libo zelenaya (pustoj
+		 * bufer), libo sobrana iz chuzhih kuskov.
+		 *
+		 * Teper' slot zapolnyaetsya vsegda: esli referens poteryan,
+		 * podstavlyaem tekushchij kadr. Kartinka na paru kadrov do
+		 * blizhajshego klyuchevogo budet nevernoj, no eto luchshe
+		 * zeleni i sohranyaet vyravnivanie tablicy.
+		 */
 		if (!frame)
-			continue;
+			continue;	/* vozmozhno tol'ko do pervogo kadra */
 
 		if (codec_hevc_use_fbc(sess->pixfmt_cap, vp9->is_10bit)) {
 			id_y = frame->index;
@@ -1173,27 +1304,29 @@ static void codec_vp9_set_mc(struct amvdec_session *sess,
 
 	amvdec_write_dos(core, VP9D_MPP_REFINFO_TBL_ACCCONFIG, BIT(2));
 	for (i = 0; i < REFS_PER_FRAME; ++i) {
-		if (!vp9->frame_refs[i])
+		struct vp9_frame *ref = codec_vp9_ref_or_fallback(vp9, i);
+
+		/*
+		 * Ta zhe lovushka, chto i v codec_vp9_set_refs(): tablica
+		 * REFINFO zapolnyaetsya po 5 slov na referens s
+		 * avtoinkrementom, i propusk sdvigaet vse posleduyushchie
+		 * zapisi. Podstavlyaem tekushchij kadr vmesto propuska.
+		 */
+		if (!ref)
 			continue;
 
-		if (vp9->frame_refs[i]->width != vp9->width ||
-		    vp9->frame_refs[i]->height != vp9->height)
+		if (ref->width != vp9->width || ref->height != vp9->height)
 			scale = 1;
 
-		sz = amvdec_amfbc_body_size(vp9->frame_refs[i]->width,
-					    vp9->frame_refs[i]->height,
+		sz = amvdec_amfbc_body_size(ref->width, ref->height,
 					    vp9->is_10bit, use_mmu);
 
+		amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA, ref->width);
+		amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA, ref->height);
 		amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA,
-				 vp9->frame_refs[i]->width);
-		amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA,
-				 vp9->frame_refs[i]->height);
-		amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA,
-				 (vp9->frame_refs[i]->width << 14) /
-				 vp9->width);
+				 (ref->width << 14) / vp9->width);
 		amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA,
-				 (vp9->frame_refs[i]->height << 14) /
-				 vp9->height);
+				 (ref->height << 14) / vp9->height);
 		amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA, sz >> 5);
 	}
 
@@ -1207,6 +1340,8 @@ static struct vp9_frame *codec_vp9_get_new_frame(struct amvdec_session *sess)
 	struct vb2_v4l2_buffer *vbuf;
 	struct vp9_frame *new_frame;
 
+	int tries;
+
 	new_frame = kzalloc_obj(*new_frame);
 	if (!new_frame)
 		return NULL;
@@ -1218,9 +1353,29 @@ static struct vp9_frame *codec_vp9_get_new_frame(struct amvdec_session *sess)
 		return NULL;
 	}
 
+	/*
+	 * 01.09.2026: dobavlen schetchik popytok.
+	 *
+	 * Cikl vrashchaet ochered: izymaet odin bufer i vozvrashchaet
+	 * predydushchij, poetomu dlina ocheredi ne ubyvaet i uslovie
+	 * v4l2_m2m_dst_buf_remove() == NULL ne nastupaet. Kogda VSE bufery
+	 * uderzhany kak referensy - a posle pravki rm_noshow_frame oni
+	 * uderzhivayutsya dolshe - cikl stanovitsya vechnym, prichem krutitsya
+	 * on v trede preryvaniya s zazhatym vp9->lock. Zavisanie bez edinoj
+	 * zapisi v zhurnal.
+	 */
+	tries = sess->num_dst_bufs + 1;
 	while (codec_vp9_get_frame_by_idx(vp9, vbuf->vb2_buf.index)) {
 		struct vb2_v4l2_buffer *old_vbuf = vbuf;
 
+		if (--tries <= 0) {
+			dev_err(sess->core->dev,
+				"Vse dst-bufery uderzhany kak referensy VP9\n");
+			v4l2_m2m_buf_queue(sess->m2m_ctx, old_vbuf);
+			kfree(new_frame);
+			return NULL;
+		}
+
 		vbuf = v4l2_m2m_dst_buf_remove(sess->m2m_ctx);
 		v4l2_m2m_buf_queue(sess->m2m_ctx, old_vbuf);
 		if (!vbuf) {
@@ -1262,6 +1417,20 @@ static void codec_vp9_rm_noshow_frame(struct amvdec_session *sess)
 		if (tmp->show)
 			continue;
 
+		/*
+		 * 01.09.2026: eto i est' istochnik "couldn't find VP9 ref N".
+		 *
+		 * Ran'she kadr udalyalsya po edinstvennoj proverke show == 0.
+		 * No show == 0 v VP9 - eto ne "kadr nenuzhen", a ZHIVOJ alt-ref:
+		 * on ne pokazyvaetsya, no na nego ssylayutsya sleduyushchie kadry.
+		 * Bufer vozvrashchalsya v ochered' i osvobozhdalsya, a ego indeks
+		 * ostavalsya v ref_frame_map - i sleduyushchij zhe kadr etot
+		 * referens uzhe ne nahodil.
+		 */
+		if (tmp == vp9->cur_frame || tmp == vp9->prev_frame ||
+		    codec_vp9_is_ref(vp9, tmp))
+			continue;
+
 		pr_debug("rm noshow: %u\n", tmp->index);
 		v4l2_m2m_buf_queue(sess->m2m_ctx, tmp->vbuf);
 		list_del(&tmp->list);
@@ -1419,17 +1588,6 @@ static int codec_vp9_process_rpm(struct codec_vp9 *vp9)
 	return src_changed;
 }
 
-static bool codec_vp9_is_ref(struct codec_vp9 *vp9, struct vp9_frame *frame)
-{
-	int i;
-
-	for (i = 0; i < REF_FRAMES; ++i)
-		if (vp9->ref_frame_map[i] == frame->index)
-			return true;
-
-	return false;
-}
-
 static void codec_vp9_show_frame(struct amvdec_session *sess)
 {
 	struct codec_vp9 *vp9 = sess->priv;
@@ -2146,8 +2304,8 @@ static irqreturn_t codec_vp9_threaded_isr(struct amvdec_session *sess)
 
 	codec_vp9_fetch_rpm(sess);
 	if (codec_vp9_process_rpm(vp9)) {
-		amvdec_src_change(sess, vp9->width, vp9->height, 16,
-				  vp9->is_10bit ? 10 : 8);
+		u32 w = vp9->width, h = vp9->height;
+		u32 bd = vp9->is_10bit ? 10 : 8;
 
 		/* No frame is actually processed */
 		vp9->cur_frame = NULL;
@@ -2159,7 +2317,31 @@ static irqreturn_t codec_vp9_threaded_isr(struct amvdec_session *sess)
 		if (vp9->frames_num)
 			codec_vp9_save_refs(vp9);
 
-		goto unlock;
+		/*
+		 * 01.09.2026: codec_vp9_save_refs() nichego ne perenosit - eto
+		 * zaglushka s pr_warn "would need to save ref". Znachit posle
+		 * smeny razresheniya karty obyazany stat' pustymi, inache
+		 * sleduyushchij inter-kadr ishchet indeksy uzhe osvobozhdennyh
+		 * kadrov i my snova poluchaem "couldn't find VP9 ref N".
+		 */
+		memset(vp9->ref_frame_map, -1, sizeof(vp9->ref_frame_map));
+		memset(vp9->next_ref_frame_map, -1,
+		       sizeof(vp9->next_ref_frame_map));
+		for (i = 0; i < REFS_PER_FRAME; ++i)
+			vp9->frame_refs[i] = NULL;
+		vp9->prev_frame = NULL;
+
+		/*
+		 * I glavnoe: amvdec_src_change() SINHRONNO zovet
+		 * codec_ops->resume() (vdec_helpers.c:494), a codec_vp9_resume()
+		 * beret vot etot samyj vp9->lock. Ran'she vyzov shel iz-pod
+		 * zazhatogo loka - tred preryvaniya blokiroval sam sebya
+		 * namertvo. Otpuskaem lok DO vyzova; nizhe metki unlock nichego
+		 * krome mutex_unlock net, poetomu vyhodim srazu.
+		 */
+		mutex_unlock(&vp9->lock);
+		amvdec_src_change(sess, w, h, 16, bd);
+		return IRQ_HANDLED;
