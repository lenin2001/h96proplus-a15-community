+int amvdec_reprogram_canvas_slot(struct amvdec_session *sess,
+				 struct vb2_buffer *vb, u32 reg_base)
+{
+	struct amvdec_core *core = sess->core;
+	u32 idx = vb->index;
+	u32 width = ALIGN(sess->width, 32);
+	u32 height = ALIGN(sess->height, 32);
+	u32 stride = width;
+	dma_addr_t y, uv;
+
+	/* tolko kanvas-put 8-bit NV12M (nash GXM) */
+	if (sess->pixfmt_cap != V4L2_PIX_FMT_NV12M)
+		return -EINVAL;
+	if (idx >= 32 || sess->slot_ncanvas[idx] < NUM_CANVAS_NV12)
+		return -EINVAL;
+	/* dma_addr validen tolko esli dmabuf primaplen (prepare/queue) */
+	if (!vb2_plane_cookie(vb, 0))
+		return -EINVAL;
+
+	/* ta zhe adresnaya arifmetika, chto v set_canvas_nv12m */
+	y  = vb2_dma_contig_plane_dma_addr(vb, 0);
+	uv = vb2_dma_contig_plane_dma_addr(vb, 1);
+	if (uv == y) {
+		stride = ALIGN(width, 64);
+		uv = y + stride * ALIGN(height, 32);
+	}
+
+	/* perekonfiguriruem UZHE vydelennye slotu canvas ID (bez alloc) */
+	meson_canvas_config(core->canvas, sess->slot_canvas[idx][0], y,
+			    stride, height, MESON_CANVAS_WRAP_NONE,
+			    MESON_CANVAS_BLKMODE_LINEAR,
+			    MESON_CANVAS_ENDIAN_SWAP64);
+	meson_canvas_config(core->canvas, sess->slot_canvas[idx][1], uv,
+			    stride, height / 2, MESON_CANVAS_WRAP_NONE,
+			    MESON_CANVAS_BLKMODE_LINEAR,
+			    MESON_CANVAS_ENDIAN_SWAP64);
+
+	amvdec_write_dos(core, reg_base + idx * 4,
+			 (sess->slot_canvas[idx][1] << 16) |
+			 (sess->slot_canvas[idx][1] << 8)  |
+			 (sess->slot_canvas[idx][0]));
+
+	sess->slot_real[idx] = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(amvdec_reprogram_canvas_slot);
