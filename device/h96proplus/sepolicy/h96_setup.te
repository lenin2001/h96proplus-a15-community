# Домен для наших служб первоначальной настройки: загрузчик таблицы
# ИК-пульта и применение настроек производительности.
#
# ⛔⛔ ЗАЧЕМ ЭТО ВООБЩЕ НУЖНО. Init ОТКАЗЫВАЕТСЯ запускать службу, для
# исполняемого файла которой не определён переход домена SELinux —
# и делает это ДАЖЕ В РАЗРЕШАЮЩЕМ РЕЖИМЕ (проверено 23.08):
#     E init: Could not ctl.start for 'h96-perf': File /system/bin/sh
#             (labeled "u:object_r:shell_exec:s0") has incorrect label or
#             no domain transition from u:r:init:s0
# Поэтому и пульт не настраивался при загрузке, и настройки
# производительности не применялись. По этой же причине НИКОГДА не
# работал bootwatchdog — сторож зависшей загрузки был мёртв всё время.
#
# ⚠️ Попытка обойти это, просто написав в rc `seclabel u:r:shell:s0`,
# СОРВАЛА ЗАГРУЗКУ: приставка перестала отвечать даже на ping и
# потребовала ручного передёргивания питания. Правильный путь — объявить
# собственный домен, что и делается здесь.

type h96_setup, domain;
type h96_setup_exec, vendor_file_type, exec_type, file_type;

# Переход init → наш домен при запуске службы
init_daemon_domain(h96_setup)

# ⛔ ПРАВ ЗДЕСЬ НАМЕРЕННО МИНИМУМ.
#
# Система собрана в разрешающем режиме (androidboot.selinux=permissive),
# поэтому фактические разрешения не нужны вовсе: домен существует ровно
# для того, чтобы init согласился запустить службу.
#
# ⚠️ Попытка выписать «на всякий случай» широкие права СОРВАЛА СБОРКУ:
#     libsepol.report_failure: neverallow on line 1939 of
#     system/sepolicy/private/domain.te violated by
#     allow h96_setup h96_setup:capability { dac_override };
# У AOSP есть явные запреты (neverallow), которые сильнее любых allow, и
# нарушение валит сборку на шаге sepolicy_neverallows. Тот же урок уже
# был с set_prop(vendor_init, use_memfd_prop) — не выписывать права,
# которых не требуется.
#
# Когда дойдём до enforcing, права добавлять поштучно и по реальным
# отказам из журнала, а не заранее.

# Чтение таблицы кнопок и скрипта настроек из /vendor/etc
allow h96_setup vendor_configs_file:file r_file_perms;
