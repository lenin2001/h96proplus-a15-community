// Пакет-пустышка, единственная задача которого — вычеркнуть телефонные
// приложения из образа приставки.
//
// Почему именно так, а не удалением из списка пакетов: базовые профили AOSP
// добавляют Telecom, TeleService и остальных не напрямую, а через цепочку
// наследования продуктов, и на момент чтения нашего device.mk этих имён в
// переменной ещё нет — отфильтровать их оттуда невозможно. Единственный
// поддерживаемый системой сборки способ убрать унаследованный пакет —
// объявить модуль, который его перекрывает (overrides). Такой модуль
// собирается в пустой APK и заменяет собой перечисленные ниже.
//
// Что уходит из образа: телефонная служба и звонилка, поставщик телефонных
// данных, служба SMS/MMS, диалог SIM-приложений, поставщик чёрного списка
// номеров, служба защищённого элемента (SIM/eSE) и обработчик WAP Push.
// Экономия — около 10 МиБ и два постоянно висящих процесса.
//
// ⚠️ Чего здесь НЕТ и быть не должно: telephony-common, voip-common,
// ims-common. Это не приложения, а библиотеки загрузочного класспуса —
// без них система не соберётся и не загрузится.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "H96NoTelephony",
    sdk_version: "current",
    manifest: "AndroidManifest.xml",
    privileged: false,
    platform_apis: false,

    overrides: [
        "Telecom",
        "TeleService",
        "TelephonyProvider",
        "TelephonyProviderHsum",
        "MmsService",
        "SimAppDialog",
        "BlockedNumberProvider",
        "SecureElement",
        "WAPPushManager",
    ],
}
