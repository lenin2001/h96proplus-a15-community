+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.view.View;
+
+/**
+ * The frame drawn over the whole screen while the size is being adjusted: all four edges, the
+ * four corners and a centre mark, so the owner can see exactly where the picture ends and pull
+ * it in until the television stops cutting it off.
+ */
+public class ScreenSizeBorderView extends View {
+
+    private static final float ARM_DP = 56f;
+    private static final float CENTRE_DP = 16f;
+    private static final float STROKE_DP = 2f;
+
+    private final Paint mUnder = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mOver = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final float mArm;
+    private final float mCentre;
+
+    public ScreenSizeBorderView(Context context) {
+        super(context);
+        final float density = context.getResources().getDisplayMetrics().density;
+        mArm = ARM_DP * density;
+        mCentre = CENTRE_DP * density;
+
+        // Drawn twice: a thick dark pass underneath keeps the frame readable on a light screen.
+        mUnder.setStyle(Paint.Style.STROKE);
+        mUnder.setColor(Color.BLACK);
+        mUnder.setStrokeWidth(STROKE_DP * density * 3f);
+
+        mOver.setStyle(Paint.Style.STROKE);
+        mOver.setColor(Color.WHITE);
+        mOver.setStrokeWidth(STROKE_DP * density);
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        draw(canvas, mUnder);
+        draw(canvas, mOver);
+    }
+
+    private void draw(Canvas canvas, Paint paint) {
+        final float w = getWidth();
+        final float h = getHeight();
+        final float inset = paint.getStrokeWidth() / 2f;
+
+        canvas.drawRect(inset, inset, w - inset, h - inset, paint);
+
+        // Corner arms: a clipped corner shows even when a whole edge is still visible.
+        canvas.drawLine(inset, mArm, mArm, inset, paint);
+        canvas.drawLine(w - mArm, inset, w - inset, mArm, paint);
+        canvas.drawLine(inset, h - mArm, mArm, h - inset, paint);
+        canvas.drawLine(w - mArm, h - inset, w - inset, h - mArm, paint);
+
+        // Centre mark, to check the picture stayed centred.
+        canvas.drawLine(w / 2f - mCentre, h / 2f, w / 2f + mCentre, h / 2f, paint);
+        canvas.drawLine(w / 2f, h / 2f - mCentre, w / 2f, h / 2f + mCentre, paint);
+    }
+}
