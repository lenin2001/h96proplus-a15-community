+    // h96: MMAP+CPU-copy output path sustains only ~10 fps at 1080p on the
+    // S912's A53 cores - not realtime, the player starves and deadlocks.
+    // Advertise 720p max so adaptive players pick a stream we can decode
+    // at full speed. Remove when a zero-copy/GE2D output path lands.
+    if (maxSize.width > 1280) maxSize.setWidth(1280);
+    if (maxSize.height > 736) maxSize.setHeight(736);
