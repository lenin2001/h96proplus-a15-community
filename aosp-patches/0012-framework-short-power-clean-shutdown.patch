+            final int shortPressDefault = mContext.getResources().getInteger(
+                    com.android.internal.R.integer.config_shortPressOnPowerBehavior);
+            // An old sleep preference in /data must not override the box's
+            // explicit poweroff policy. Other devices keep stock behavior.
+            mShortPressOnPowerBehavior = shortPressDefault == SHORT_PRESS_POWER_SHUTDOWN_NO_CONFIRM
