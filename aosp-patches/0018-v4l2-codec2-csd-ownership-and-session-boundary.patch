-     * один PPS, без SPS не поднимался CMD_SRC_CHANGE, декодер молчал ~20 с. */
-    std::vector<C2ConstLinearBlock> mCsdRun;
+     * поэтому после flush повторяем серию целиком, в исходном порядке.
+     *
+     * h96 18.09: храним СОБСТВЕННЫЕ байты, а не C2ConstLinearBlock клиента.
+     * C2ConstLinearBlock - только ссылка на аллокацию входного пула CCodec
+     * (C2Buffer.h:1236); в array-режиме MediaCodec тот же самый C2LinearBlock
+     * выдаётся клиенту обратно и перезаписывается сразу после того, как мы
+     * отпускаем work->input.buffers (CCodecBuffers.cpp:772-791 +
+     * CCodecBufferChannel.cpp:2383), а V4L2Decoder читает байты только в момент
+     * QBUF (V4L2Decoder.cpp:532-544), т.е. уже при повторе. Плюс каждая ссылка
+     * держала до 1 МиБ входного пула (CCodecBuffers.h:40). */
+    std::vector<std::vector<uint8_t>> mCsdRunBytes;
+    // Блоки для повтора, собранные из |mCsdRunBytes| в нашем пуле.
+    std::vector<C2ConstLinearBlock> mCsdRunBlocks;
+    std::shared_ptr<C2BlockPool> mCsdBlockPool;
     bool mCsdRunOpen = false;  // true, пока приходят подряд идущие CSD-работы
     // The queue of works that haven't processed and sent to |mDecoder|.
     std::queue<std::unique_ptr<C2Work>> mPendingWorks;
