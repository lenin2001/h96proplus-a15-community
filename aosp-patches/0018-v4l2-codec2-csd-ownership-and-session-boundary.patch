     processWorkBuffer(bitstreamId, linearBlock);
 }
 
+/* h96 18.09: копия БАЙТОВ CSD. Новая серия (после обычных кадров) заменяет
+ * старую; внутри серии блоки копятся по порядку: SPS, PPS[, PPS...]. */
+void DecodeComponent::cacheCsd(const C2ConstLinearBlock& linearBlock) {
+    ALOG_ASSERT(mDecoderTaskRunner->RunsTasksInCurrentSequence());
+
+    C2ReadView view = linearBlock.map().get();
+    if (view.error() != C2_OK || view.capacity() == 0u) {
+        ALOGE("h96: cannot map CSD block (err=%d, cap=%u), CSD run not updated", view.error(),
+              view.capacity());
+        return;
+    }
+
+    if (!mCsdRunOpen) {
+        mCsdRunBytes.clear();
+        mCsdRunBlocks.clear();
+    }
+    mCsdRunOpen = true;
+    mCsdRunBytes.emplace_back(view.data(), view.data() + view.capacity());
+    mCsdRunBlocks.clear();  // собрать заново вместе с новым элементом
+    buildCsdBlocks();       // заранее, чтобы seek не платил за аллокацию
+    ALOGI("h96: CSD cached, run=%zu blocks, last=%u bytes", mCsdRunBytes.size(), view.capacity());
+}
+
+/* Пересобирает |mCsdRunBlocks| из |mCsdRunBytes| в BASIC_LINEAR-пуле, которым
+ * владеем мы. V4L2Decoder всё равно копирует байты в MMAP-буфер драйвера
+ * (V4L2Decoder.cpp:532-544), так что любая линейная аллокация подходит. */
+bool DecodeComponent::buildCsdBlocks() {
+    if (mCsdRunBlocks.size() == mCsdRunBytes.size()) return true;
+
+    if (!mCsdBlockPool) {
+        c2_status_t status = GetCodec2BlockPool(C2BlockPool::BASIC_LINEAR, nullptr, &mCsdBlockPool);
+        if (status != C2_OK || !mCsdBlockPool) {
+            ALOGE("h96: no BASIC_LINEAR pool for CSD replay: %d", status);
+            mCsdBlockPool = nullptr;
+            return false;
+        }
+    }
+
+    mCsdRunBlocks.clear();
+    C2MemoryUsage usage{C2MemoryUsage::CPU_READ, C2MemoryUsage::CPU_WRITE};
+    for (const std::vector<uint8_t>& csd : mCsdRunBytes) {
+        std::shared_ptr<C2LinearBlock> block;
+        c2_status_t status = mCsdBlockPool->fetchLinearBlock(csd.size(), usage, &block);
+        if (status != C2_OK || !block) {
+            ALOGE("h96: fetchLinearBlock(%zu) for CSD replay failed: %d", csd.size(), status);
+            mCsdRunBlocks.clear();
+            return false;
+        }
+        C2WriteView wView = block->map().get();
+        if (wView.error() != C2_OK) {
+            ALOGE("h96: cannot map CSD replay block: %d", wView.error());
+            mCsdRunBlocks.clear();
+            return false;
+        }
+        memcpy(wView.data(), csd.data(), csd.size());
+        mCsdRunBlocks.push_back(block->share(0u, csd.size(), C2Fence()));
+    }
+    return true;
+}
+
+void DecodeComponent::clearCsdRun(const char* reason) {
+    if (!mCsdRunBytes.empty() || mCsdRunOpen) {
+        ALOGI("h96: CSD run cleared at session boundary (%s): %zu blocks dropped", reason,
+              mCsdRunBytes.size());
+    }
+    mCsdRunBytes.clear();
+    mCsdRunBlocks.clear();
+    mCsdRunOpen = false;
+    mCsdBlockPool = nullptr;
+}
+
 void DecodeComponent::processWorkBuffer(const int32_t bitstreamId,
                                         const C2ConstLinearBlock& linearBlock) {
     std::unique_ptr<ConstBitstreamBuffer> buffer = std::make_unique<ConstBitstreamBuffer>(
@@ -714,21 +791,23 @@ void DecodeComponent::flushTask() {
      * SPS/PPS теряются), а CCodec пересылает CSD только из flushedWork, которого мы не
      * даём. Для DASH avc1/hvc1 (YouTube AVC) после seek приходили одни слайсы - ни
      * кадров, ни SOURCE_CHANGE. Повторяем последний CSD первым же буфером. */
-    if (!mCsdRun.empty() && (mIntfImpl->getVideoCodec() == VideoCodec::H264 ||
-                            mIntfImpl->getVideoCodec() == VideoCodec::HEVC)) {
+    if (!mCsdRunBytes.empty() && (mIntfImpl->getVideoCodec() == VideoCodec::H264 ||
+                                  mIntfImpl->getVideoCodec() == VideoCodec::HEVC)) {
         /* h96 16.09: повторяем ВСЮ серию CSD (SPS, потом PPS[, ...]) в исходном
          * порядке. id = -2, -3, ... - отрицательные, никогда не совпадут с
          * frameIndex настоящих AU. Это ровно стартовая последовательность,
          * которую firmware принимает (два CSD-work -> src_change за ~5 мс). */
+        if (!buildCsdBlocks()) {
+            ALOGE("h96: CSD replay skipped, %zu blocks unavailable", mCsdRunBytes.size());
+        }
         int32_t replayId = -2;
-        for (const C2ConstLinearBlock& csd : mCsdRun) {
+        for (const C2ConstLinearBlock& csd : mCsdRunBlocks) {
             mDecoder->decode(std::make_unique<ConstBitstreamBuffer>(replayId, csd,
                                                                     csd.offset(), csd.size()),
                              ::base::BindOnce([](VideoDecoder::DecodeStatus) {}));
             ALOGV("h96: CSD replayed after flush id=%d size=%zu", replayId, csd.size());
             --replayId;
         }
-        mCsdRunOpen = false;
     }
 
     // Pending EOS work will be abandoned here due to component flush if any.
