+# Профиль 2026-09-06: RAW NEC + h96mouse
+
+Активная карта Android — `h96-remote.map`: измеренный пульт с адресом 0x01,
+кнопка мыши `0x100 -> KEY_F13 (183)`. TOML ниже — старый справочник другой
+партии, он не используется службой `h96-irkeymap`.
+
+`h96mouse` входит в PRODUCT_PACKAGES, создаёт `h96-remote` и
+`h96-remote-mouse`. Первая кнопка мыши включает режим, вторая выключает.
+Стрелки перемещают курсор, OK нажимает/отпускает левую кнопку. BACK, HOME,
+громкость и POWER остаются клавишами, режим мыши не выключают.
+
+Обязательно: RAW `amlogic,meson-gxbb-ir`, `CONFIG_INPUT_UINPUT=y`,
+карта с KEY_F13 и патч framework 0012. В HW-ветке ядра 0012/0019 перехватывают
+кнопки раньше userspace, поэтому два обработчика одновременно использовать нельзя.
+Холодное включение после poweroff обслуживает загрузчик/SCP, а не этот демон.
+
diff --git a/device/h96proplus/remote/h96-remote.map b/device/h96proplus/remote/h96-remote.map
index b5e65a2..dcc7328 100644
--- a/device/h96proplus/remote/h96-remote.map
+++ b/device/h96proplus/remote/h96-remote.map
@@ -30,6 +30,7 @@
 0x111 172    # домой          KEY_HOMEPAGE
 0x14c 139    # меню           KEY_MENU
 0x140 116    # выключение     KEY_POWER
+0x100 183    # мышь           KEY_F13; consumes press/release in h96mouse
 
 # --- громкость ---
 0x118 115    # громкость +    KEY_VOLUMEUP
diff --git a/device/h96proplus/sepolicy/file_contexts b/device/h96proplus/sepolicy/file_contexts
index 895db5a..4fb7b69 100644
--- a/device/h96proplus/sepolicy/file_contexts
+++ b/device/h96proplus/sepolicy/file_contexts
@@ -33,6 +33,7 @@
 # «File /vendor/bin/irkeymap has incorrect label or no domain transition».
 # Домен объявлен в h96_setup.te.
 /vendor/bin/irkeymap                                                     u:object_r:h96_setup_exec:s0
+/vendor/bin/h96mouse                                                     u:object_r:h96mouse_exec:s0
 
 # Драйвер графики Mesa/panfrost лежит в /vendor/lib64/dri. Каталог egl рядом
 # платформа метит сама, а dri — нет: без этой строки библиотека драйвера
diff --git a/device/h96proplus/sepolicy/h96mouse.te b/device/h96proplus/sepolicy/h96mouse.te
new file mode 100644
index 0000000..5f865d7
--- /dev/null
+++ b/device/h96proplus/sepolicy/h96mouse.te
@@ -0,0 +1,8 @@
+# Native IR input translator. No shell, network, properties or power privileges.
+type h96mouse, domain;
+type h96mouse_exec, vendor_file_type, exec_type, file_type;
+init_daemon_domain(h96mouse)
+
+allow h96mouse input_device:dir r_dir_perms;
+allow h96mouse input_device:chr_file r_file_perms;
+allow h96mouse uinput_device:chr_file rw_file_perms;
