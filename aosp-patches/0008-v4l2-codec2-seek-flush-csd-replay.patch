+                                                                mLastCsd->size()),
+                         ::base::BindOnce([](VideoDecoder::DecodeStatus) {}));
+        ALOGV("h96: CSD replayed after flush");
+    }
+
     // Pending EOS work will be abandoned here due to component flush if any.
     mIsDraining = false;
 }
