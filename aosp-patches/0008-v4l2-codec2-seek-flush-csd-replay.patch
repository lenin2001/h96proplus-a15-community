+    if (mLastCsd && (mIntfImpl->getVideoCodec() == VideoCodec::H264 ||
+                     mIntfImpl->getVideoCodec() == VideoCodec::HEVC)) {
+        constexpr int32_t kCsdReplayId = -2;
+        mDecoder->decode(std::make_unique<ConstBitstreamBuffer>(kCsdReplayId, *mLastCsd,
